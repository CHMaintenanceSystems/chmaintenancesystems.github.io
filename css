style.css
*{

margin:0;

padding:0;

box-sizing:border-box;

}

body{

font-family:'Montserrat',sans-serif;

background:#071827;

color:white;

}

nav{

position:fixed;

top:0;

left:0;

width:100%;

display:flex;

justify-content:space-between;

align-items:center;

padding:20px 60px;

background:rgba(7,24,39,.95);

backdrop-filter:blur(15px);

z-index:1000;

}

.logo img{

height:70px;

}

nav ul{

display:flex;

gap:40px;

list-style:none;

}

nav a{

color:white;

text-decoration:none;

font-weight:600;

transition:.3s;

}

nav a:hover{

color:#3b82f6;

}

.hero{

height:100vh;

display:flex;

justify-content:center;

align-items:center;

text-align:center;

padding:0 20px;

background:linear-gradient(

180deg,

#071827,

#0b2036

);

}

.hero-content{

max-width:900px;

}

.hero h1{

font-size:4rem;

font-weight:800;

line-height:1.1;

margin-bottom:30px;

}

.hero p{

font-size:1.3rem;

line-height:1.8;

color:#cbd5e1;

margin-bottom:40px;

}

.buttons{

display:flex;

justify-content:center;

gap:20px;

flex-wrap:wrap;

}

.btn{

padding:18px 40px;

background:#0B4EA2;

color:white;

text-decoration:none;

border-radius:8px;

font-weight:700;

transition:.3s;

}

.btn:hover{

transform:translateY(-4px);

background:#2563eb;

}

.btn-outline{

padding:18px 40px;

border:2px solid #0B4EA2;

border-radius:8px;

text-decoration:none;

color:white;

font-weight:700;

transition:.3s;

}

.btn-outline:hover{

background:#0B4EA2;

}

.intro{

max-width:1100px;

margin:auto;

padding:120px 40px;

text-align:center;

}

.intro h2{

font-size:3rem;

margin-bottom:30px;

}

.intro p{

font-size:1.2rem;

line-height:2;

color:#cbd5e1;

}

@media(max-width:900px){

nav{

padding:20px;

flex-direction:column;

gap:20px;

}

nav ul{

flex-wrap:wrap;

justify-content:center;

gap:20px;

}

.hero h1{

font-size:2.6rem;

}

}
